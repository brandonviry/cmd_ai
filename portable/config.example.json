{
  "version": 1,
  "provider": {
    "base_url": "https://ollama.com/v1",
    "api_key": "",
    "model": "beam",
    "roles": { "fast": "gpt-oss:120b", "fr": "mistral-large-4" },
    "max_tokens": 16384,
    "timeout_secs": 300
  },
  "permissions": "plan",
  "ui": { "tui": true, "color": "auto", "theme": "auto", "show_reasoning": false },
  "network": { "proxy": null, "ca_file": null, "connect_timeout_secs": 15 },
  "limits": {
    "command_timeout_secs": 120, "max_steps": 30, "max_fixes": 2, "model_output_kib": 16,
    "capture_mib": 1, "log_file_mib": 10, "log_total_mib": 50, "memory_max_notes": 200
  },
  "garde_fous": [
    "*rm -*r* /",
    "*rm -*r* / *",
    "*rm -*r* /?",
    "*rm -*r* ~",
    "*rm -*r* ~/",
    "*rm -*r* ~ *",
    "*rm -*r* ~/?",
    "*rm -*r* $home",
    "*rm -*r* $home/",
    "*rm -*r* $home/?",
    "*--no-preserve-root*",
    "*remove-item*-r* ?:\\",
    "*remove-item*-r* ?:\\ *",
    "*remove-item*-r* ?:\\?",
    "*remove-item ?:\\ *-r*",
    "*remove-item -path ?:\\ *-r*",
    "*remove-item*-r* ~",
    "*remove-item*-r* $home",
    "*remove-item*-r* $env:userprofile",
    "*rm -*r* ?:\\",
    "*rm -*r* ?:\\?",
    "*rd /s* ?:\\",
    "*rmdir /s* ?:\\",
    "*rd /s* %userprofile%",
    "*rmdir /s* %userprofile%",
    "*del */s* ?:\\",
    "*del */s* ?:\\?",
    "*del */s* ?:\\?.?",
    "*format ?:",
    "*format ?: *",
    "*format-volume*",
    "*clear-disk*",
    "*initialize-disk*",
    "*remove-partition*",
    "*diskpart*",
    "*mkfs*",
    "*wipefs*",
    "*fdisk*",
    "*parted*",
    "*dd *of=/dev/*",
    "*> /dev/sd*",
    "*>/dev/sd*",
    "*> /dev/nvme*",
    "*>/dev/nvme*",
    "*> /dev/disk*",
    "*>/dev/disk*",
    "*> /dev/mmcblk*",
    "*>/dev/mmcblk*",
    "*shred *",
    "*cipher /w*",
    "*vssadmin delete*",
    "*shadowcopy delete*",
    "*bcdedit*",
    "*reg delete hklm*",
    "*reg delete \"hklm*",
    "*reg delete hkey_local_machine*",
    "*reg delete \"hkey_local_machine*",
    "*remove-item*hklm:*",
    "*chmod -r* /",
    "*chmod -r* / *",
    "*chmod -r* /?",
    "*chown -r* /",
    "*chown -r* / *",
    "*chown -r* /?",
    "*icacls ?:\\ */t*",
    "*takeown /f ?:\\ */r*",
    "*:(){*:|:*&*};*:*",
    "*%0|%0*",
    "*curl *|*sh",
    "*curl *|*sh *",
    "*wget *|*sh",
    "*wget *|*sh *",
    "*sh <(curl*",
    "*sh <(wget*",
    "*irm *|*iex*",
    "*iwr *|*iex*",
    "*invoke-restmethod*|*iex*",
    "*invoke-webrequest*|*iex*",
    "*|*invoke-expression*",
    "*iex*(irm *",
    "*iex*(iwr *",
    "*downloadstring(*",
    "*shutdown*",
    "*stop-computer*",
    "*restart-computer*",
    "*reboot*",
    "*poweroff*"
  ],
  "hooks": {
    "session_start": [],
    "pre_command":  [{ "match": "git push*", "run": "git status --short", "shell": null, "timeout_secs": 30 }],
    "post_command": [],
    "file_changed": [{ "paths": ["package.json"], "run": "npm install --dry-run" }],
    "task_end": []
  }
}
