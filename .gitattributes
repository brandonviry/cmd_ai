# Text files are stored with LF and checked out with LF on every OS (Rust, Markdown, YAML,
# JSON...): the portable folder is shared by Windows, Linux and macOS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# POSIX launchers must never get a CR (`/bin/sh^M: bad interpreter`).
*.sh text eol=lf
*.command text eol=lf

# Binary files: no conversion, no textual diff.
